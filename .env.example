# ============================================================================
# SCOTIABANK MULTI-AGENT BUSINESS INSIGHT SYSTEM
# Environment Configuration Template
# ============================================================================

# ----------------------------------------------------------------------------
# OpenAI API Configuration (for Gemini via OpenAI-compatible endpoint)
# ----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ----------------------------------------------------------------------------
# Model Selection (Optional - defaults provided)
# ----------------------------------------------------------------------------
# Worker Agent Model (fast, for code generation and execution)
GEMINI_FLASH_MODEL=gemini-2.0-flash-exp

# Planner Agent Model (can use same or upgrade to pro for better reasoning)
GEMINI_PRO_MODEL=gemini-2.0-flash-exp
# GEMINI_PRO_MODEL=gemini-1.5-pro  # Uncomment for better planning

# ----------------------------------------------------------------------------
# Optional: Langfuse Observability
# ----------------------------------------------------------------------------
# For tracing and monitoring agent interactions
# Sign up at: https://cloud.langfuse.com
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ----------------------------------------------------------------------------
# Optional: Weaviate Vector Database
# ----------------------------------------------------------------------------
# Only needed if adding knowledge base search capabilities
# WEAVIATE_HTTP_HOST=localhost
# WEAVIATE_HTTP_PORT=8080
# WEAVIATE_HTTP_SECURE=false
# WEAVIATE_GRPC_HOST=localhost
# WEAVIATE_GRPC_PORT=50051
# WEAVIATE_GRPC_SECURE=false
# WEAVIATE_API_KEY=

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
# GRADIO_SERVER_PORT=7866
# GRADIO_SHARE=true
